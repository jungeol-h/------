# 환경변수 템플릿 — 이 파일을 복사해 .env 로 만들고 실제 값을 채운다.
# .env 는 git에 커밋하지 않는다 (.gitignore 처리됨).

# Supabase 연결 — 프로젝트 설정 > API 에서 확인
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 관리자 로그인 비밀번호
VITE_ADMIN_PASSWORD=

# Sentry 에러 모니터링 DSN — 미설정 시 Sentry 비활성(앱은 정상 동작)
VITE_SENTRY_DSN=

# Sentry release 식별자 (배포 SHA 등) — 런타임에서 이벤트에 붙는다.
# Vercel: $VERCEL_GIT_COMMIT_SHA 권장.
VITE_SENTRY_RELEASE=

# Sentry sourcemap 업로드용 (vite.config.js 빌드 시점에만 사용).
# 셋 다 채워져야 sentryVitePlugin이 활성화된다. 로컬 빌드에선 비워두면 skip.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_RELEASE=
